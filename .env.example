# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
# See DEPLOY.md.

# Public address of the app as users open it in the browser (no trailing slash)
PUBLIC_URL=http://example.com
# Host port nginx listens on
HTTP_PORT=80

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# InfluxDB 1.x HTTP API (host.docker.internal = the Docker host itself)
INFLUX_HOST=http://host.docker.internal:8086
INFLUX_USER=alarmread
INFLUX_PASSWORD=

# Log every SQL statement (debugging only)
#SQL_ECHO=1

# Nightly loading of new units and meters from InfluxDB (0 = off) and its hour in UTC (runs at :30)
#UNIT_SYNC=1
#UNIT_SYNC_HOUR_UTC=2
